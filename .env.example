# ============================================
# CONFIGURACIÓN document-crud-service
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- MongoDB ---
MONGO_ROOT_USERNAME=pdf_admin
MONGO_ROOT_PASSWORD=cambia_esta_contraseña_en_produccion
MONGO_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017/pdf_extractor_db?authSource=admin
MONGO_DB_NAME=pdf_extractor_db
MONGO_TIMEOUT_MS=5000

# --- Logging ---
LOGLEVEL=info

# --- Auth interna ---
INTERNAL_API_TOKEN=tu_token_aqui_cambialo_en_produccion

# --- Límites ---
MAX_TEXT_BYTES=15728640
PAGE_SIZE_MAX=100
