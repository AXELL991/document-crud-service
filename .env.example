# ============================================
# CONFIGURACIÓN document-crud-service - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- MongoDB ---
# URI de conexión a MongoDB (usar nombre de servicio Docker en compose)
# En producción, crear un usuario limitado a document_crud_db
MONGO_URI=mongodb://mongouser:mongopassword@mongo:27017/document_crud_db?authSource=admin
# Base de datos propia de este servicio (NO compartir con otros servicios)
MONGO_DB_NAME=document_crud_db
# Timeout de selección de servidor en milisegundos
MONGO_TIMEOUT_MS=5000

# --- Logging ---
LOGLEVEL=info

# --- Auth interna ---
# Token que deben enviar los servicios en la cabecera X-Internal-Token
# Generar con: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me

# --- Límites ---
# Tamaño máximo del campo 'text' en bytes (debajo del límite BSON de 16 MB)
MAX_TEXT_BYTES=15728640
# Tamaño máximo de página para listados
PAGE_SIZE_MAX=100
