# ============================================
# CONFIGURACIÓN DOCUMENT CRUD SERVICE - EJEMPLO
# ============================================

# --- CONFIGURACIÓN BASE DE DATOS (MongoDB) ---
# URI de conexión a MongoDB (usando el contenedor 'mongo' del compose)
MONGO_URI=mongodb://mongo:27017/pdf_extractor_db
MONGO_DB_NAME=pdf_extractor_db

# --- CONFIGURACIÓN LOGGING ---
# Nivel de logging (debug, info, warning, error)
LOGLEVEL=info

# --- RECURSOS DE DOCKER (informativo) ---
CPU_LIMIT=1
MEMORY_LIMIT=512m

