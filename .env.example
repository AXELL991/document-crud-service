# ============================================
# CONFIGURACIÓN document-crud-service - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# --- MongoDB (sin auth en desarrollo, coincide con docker-compose) ---
MONGO_URI=mongodb://mongo:27017/pdf_extractor_db
MONGO_DB_NAME=pdf_extractor_db
MONGO_TIMEOUT_MS=5000

# --- Logging ---
LOGLEVEL=info

# --- Auth interna (coincidir con extractor y orquestador) ---
INTERNAL_API_TOKEN=your-secure-token-here

# --- Límites ---
MAX_TEXT_BYTES=15728640
PAGE_SIZE_MAX=100